---
const links=[['Início','/'],['Projetos','/#projetos'],['Serviços','/#servicos'],['Sobre','/sobre'],['Contato','/#orcamento']];
---
<header class="header"><div class="container inner"><a class="brand" href="/" aria-label="Laura Dev Code, início">Laura <span>Dev Code</span></a><nav id="main-nav" aria-label="Navegação principal">{links.map(([name,url])=><a href={url}>{name}</a>)}<a class="nav-cta" href="https://wa.me/5561998213684?text=Ol%C3%A1%2C%20Laura%21%20Vi%20seu%20portf%C3%B3lio%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto.">Falar pelo WhatsApp <span aria-hidden="true">↗</span></a></nav><button class="menu" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menu"><span></span><span></span></button></div></header>
<script>const button=document.querySelector<HTMLButtonElement>('.menu');const nav=document.querySelector<HTMLElement>('#main-nav');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));button.setAttribute('aria-label',open?'Abrir menu':'Fechar menu');nav?.classList.toggle('open',!open)});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','Abrir menu')}));document.addEventListener('keydown',e=>{if(e.key==='Escape' && nav?.classList.contains('open')){nav.classList.remove('open');button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','Abrir menu');button?.focus()}});</script>
<style>.header{position:sticky;top:0;z-index:50;background:var(--paper)}.inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:35px}.brand{font:800 25px Manrope,sans-serif;letter-spacing:-.065em;white-space:nowrap}.brand span{color:var(--red)}nav{display:flex;align-items:center;gap:34px}nav>a{font-size:13px;font-weight:700}nav>a:hover{color:var(--red)}.nav-cta{background:var(--ink);color:white;padding:14px 18px}.nav-cta:hover{background:var(--red);color:white}.nav-cta span{margin-left:10px}.menu{display:none;background:none;border:0;padding:10px}.menu span{display:block;background:var(--ink);width:26px;height:2px;margin:6px 0}@media(max-width:900px){nav{gap:17px}.inner{min-height:66px}.brand{font-size:22px}}@media(max-width:940px){.menu{display:block}nav{display:none;position:absolute;top:100%;left:0;right:0;background:var(--paper);padding:25px 20px 35px;box-shadow:0 20px 30px #0001;flex-direction:column;align-items:stretch;gap:8px;max-height:calc(100dvh - 66px);overflow-y:auto}nav>a{padding:12px 8px;min-height:44px}nav.open{display:flex}.nav-cta{text-align:center}}.inner{position:relative}.brand{letter-spacing:-.055em;font-size:23px}nav{gap:clamp(16px,2.3vw,34px)}.nav-cta{font-weight:700} @media(min-width:901px){nav>a:not(.nav-cta){font-weight:600}}@media(max-width:720px){.brand{font-size:21px}} </style>
