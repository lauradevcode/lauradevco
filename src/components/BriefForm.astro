---
const { compact = false } = Astro.props;
---
<section class:list={["brief-section", {compact}]} id="orcamento" aria-labelledby="brief-title">
  <div class="container brief-layout">
    <div class="brief-intro" data-reveal>
      <span class="eyebrow">Vamos conversar</span>
      <h2 id="brief-title">Me conte o que você precisa. Vamos avaliar o melhor caminho.</h2>
      <p>Pode ser um site, um sistema, anúncios ou sua presença no Google. Explique seu objetivo e iniciamos a conversa pelo WhatsApp.</p>
      <p class="brief-location">Brasília, DF · Atendimento presencial mediante agendamento e remoto para todo o Brasil.</p>
    </div>
    <form class="brief-form" data-brief-form data-reveal>
      <div class="form-row">
        <div class="field"><label for="lead-nome">Seu nome <span aria-hidden="true">*</span></label><input id="lead-nome" name="nome" type="text" autocomplete="name" maxlength="80" placeholder="Seu nome" required /></div>
        <div class="field"><label for="lead-whatsapp">WhatsApp com DDD <span aria-hidden="true">*</span></label><input id="lead-whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" placeholder="(61) 99999-9999" required pattern="[+0-9() .-]{10,20}" /></div>
      </div>
      <div class="field"><label for="lead-servico">Qual serviço você procura? <span aria-hidden="true">*</span></label><select id="lead-servico" name="servico" required><option value="" selected disabled>Escolha uma opção</option><option>Site institucional</option><option>Página de vendas</option><option>Loja virtual</option><option>Sistema para meu negócio</option><option>Plataforma de atendimento online</option><option>Gestão de Google Ads</option><option>Gestão de Meta Ads</option><option>Design para redes sociais</option><option>Carrosséis, posts e conteúdo</option><option>Google Meu Negócio / Otimização de perfil</option><option>Outro / Ainda não sei</option></select></div>
      <div class="field"><label for="lead-projeto">Fale um pouco da sua ideia <span aria-hidden="true">*</span></label><textarea id="lead-projeto" name="projeto" rows="4" maxlength="1400" placeholder="O que você precisa, qual problema quer resolver e qual resultado espera?" required></textarea></div>
      <div class="field"><label for="lead-orcamento">Qual orçamento você tem em mente?</label><select id="lead-orcamento" name="orcamento"><option value="Ainda não defini" selected>Ainda não defini</option><option>Até R$ 1.000</option><option>De R$ 1.000 a R$ 3.000</option><option>De R$ 3.000 a R$ 5.000</option><option>De R$ 5.000 a R$ 10.000</option><option>Acima de R$ 10.000</option><option>Prefiro conversar sobre isso</option></select></div>
      <button class="btn brief-submit" type="submit">Falar com Laura no WhatsApp <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
      <p class="form-footnote">Ao enviar, seu WhatsApp será aberto com as respostas preenchidas. Você poderá revisar e confirmar o envio.</p>
      <p class="form-feedback" data-form-feedback role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-brief-form]').forEach(form => {
    const field = form.querySelector<HTMLInputElement>('[name="whatsapp"]');
    field?.addEventListener('input', () => field.setCustomValidity(''));
    form.addEventListener('submit', event => {
      event.preventDefault();
      const feedback = form.querySelector<HTMLElement>('[data-form-feedback]');
      const data = new FormData(form);
      const whatsapp = String(data.get('whatsapp') ?? '').trim();
      const digits = whatsapp.replace(/\D/g,'');
      if (digits.length < 10 || digits.length > 13) {
        field?.setCustomValidity('Informe um WhatsApp válido com DDD.');
        field?.reportValidity();
        return;
      }
      const message = [
        'Olá, vim do site LauraDevCode e gostaria de conversar sobre um projeto.',
        '',
        `*Nome:* ${String(data.get('nome') ?? '').trim()}`,
        `*Meu WhatsApp:* ${whatsapp}`,
        `*Serviço desejado:* ${data.get('servico')}`,
        `*Sobre o projeto:* ${String(data.get('projeto') ?? '').trim()}`,
        `*Orçamento disponível:* ${data.get('orcamento') || 'Ainda não defini'}`
      ].join('\n');
      const url = `https://wa.me/5561998213684?text=${encodeURIComponent(message)}`;
      if(feedback) feedback.textContent = 'Abrindo o WhatsApp com seu briefing...';
      // Direct navigation is reliably supported on mobile and avoids popup blockers.
      window.location.assign(url);
    });
  });
</script>
<style>
.brief-section{padding:clamp(72px,9vw,132px) 0;background:#eeeae5;scroll-margin-top:30px}.brief-layout{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(40px,7vw,125px);align-items:start}.brief-intro{position:sticky;top:40px}.brief-intro h2{max-width:560px;margin:23px 0}.brief-intro>p{max-width:460px;color:#57534f;font-size:17px}.brief-location{font-size:13px!important;margin-top:50px}.brief-form{display:grid;gap:22px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:flex;flex-direction:column;gap:9px}.field label{font-size:13px;font-weight:700;color:#262424}.field label span{color:var(--red)}.field input,.field select,.field textarea{width:100%;border:1px solid #b9b3ac;background:#faf9f7;border-radius:0;padding:15px 16px;color:#191919;font-family:inherit;font-size:15px;min-height:53px;transition:border-color .2s,background .2s,box-shadow .2s}.field textarea{min-height:140px;resize:vertical;line-height:1.6}.field :is(input,select,textarea):hover{border-color:#79716b}.field :is(input,select,textarea):focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px #c92b3520;background:white}.field input::placeholder,.field textarea::placeholder{color:#817c77}.brief-submit{justify-content:space-between;width:100%;margin-top:3px}.brief-submit svg{height:20px;width:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}.brief-submit:hover svg{transform:translateX(5px)}.form-footnote{color:#68635e;font-size:12px;line-height:1.6;margin:-3px 0 0}.form-feedback{color:var(--red);font-size:13px;margin:0}.form-feedback:empty{display:none}@media(max-width:860px){.brief-layout{grid-template-columns:1fr;gap:30px}.brief-intro{position:static}.brief-location{margin-top:16px}}@media(max-width:580px){.form-row{grid-template-columns:1fr}.brief-section{padding:70px 0}.brief-intro>p{font-size:15px}}
</style>
