---
import { socialCollections } from '../data/socialMedia';
---
<div class="social-gallery" data-social-gallery>
  {socialCollections.map((collection) => (
    <section class="social-collection" id={`serie-${collection.id}`} aria-label={`Carrossel: ${collection.title}`}>
      <div class="social-collection-head">
        <div class="social-collection-heading">
          <span class="eyebrow">{collection.label}</span>
          <h3>{collection.title}</h3>
          <p>{collection.summary}</p>
        </div>
        <div class="social-collection-controls" aria-label={`Navegar no carrossel ${collection.title}`}>
          <span class="social-count">06 ARTES / 4:5</span>
          <button type="button" class="social-control" data-rail-prev={collection.id} aria-label={`Voltar artes de ${collection.title}`}>←</button>
          <button type="button" class="social-control" data-rail-next={collection.id} aria-label={`Avançar artes de ${collection.title}`}>→</button>
        </div>
      </div>
      <div class="social-rail" id={`rail-${collection.id}`} data-social-rail={collection.id} tabindex="0" role="region" aria-label={`Artes de ${collection.title}; deslize para visualizar`}>
        {collection.slides.map((slide, index) => (
          <div class="social-slide">
            <button class="social-slide-open" type="button" data-social-open={`${collection.id}:${index}`} aria-label={`Ampliar arte ${index + 1} de 6: ${slide.label}`}>
              <img src={slide.image} alt={`Arte ${index + 1} de 6 do carrossel ${collection.title}: ${slide.label}`} loading="lazy" width="1080" height="1350" decoding="async" />
              <span class="social-slide-view" aria-hidden="true">Ampliar ↗</span>
            </button>
            <div class="social-slide-meta"><span>{String(index + 1).padStart(2, '0')} / 06</span><span>{slide.label}</span></div>
          </div>
        ))}
      </div>
    </section>
  ))}
  <dialog class="social-lightbox" data-social-dialog aria-label="Visualização ampliada das artes">
    <div class="social-lightbox-inner">
      <div class="social-lightbox-top">
        <div class="social-lightbox-caption"><span data-social-dialog-series></span><strong data-social-dialog-title></strong></div>
        <button type="button" class="social-lightbox-close" data-social-close aria-label="Fechar visualização">Fechar ×</button>
      </div>
      <div class="social-lightbox-main">
        <button type="button" class="social-lightbox-arrow" data-social-dialog-prev aria-label="Arte anterior">←</button>
        <img data-social-dialog-image src="/images/social-media/ansiedade-01.webp" alt="Arte ampliada" width="1080" height="1350" />
        <button type="button" class="social-lightbox-arrow" data-social-dialog-next aria-label="Próxima arte">→</button>
      </div>
      <div class="social-lightbox-foot"><span data-social-dialog-counter>01 / 06</span><span>Use as setas para navegar</span></div>
    </div>
  </dialog>
</div>
<script>
import { socialCollections } from '../data/socialMedia';

document.querySelectorAll<HTMLElement>('[data-social-gallery]').forEach((gallery) => {
  const modal = gallery.querySelector<HTMLDialogElement>('[data-social-dialog]');
  const image = gallery.querySelector<HTMLImageElement>('[data-social-dialog-image]');
  const seriesLabel = gallery.querySelector<HTMLElement>('[data-social-dialog-series]');
  const titleLabel = gallery.querySelector<HTMLElement>('[data-social-dialog-title]');
  const counter = gallery.querySelector<HTMLElement>('[data-social-dialog-counter]');
  let seriesIndex = 0;
  let slideIndex = 0;
  let previousFocus: HTMLElement | null = null;
  const update = () => {
    const collection = socialCollections[seriesIndex];
    const slide = collection.slides[slideIndex];
    if (image) { image.src = slide.image; image.alt = `${collection.title}: ${slide.label}`; }
    if (seriesLabel) seriesLabel.textContent = collection.title;
    if (titleLabel) titleLabel.textContent = slide.label;
    if (counter) counter.textContent = `${String(slideIndex + 1).padStart(2,'0')} / ${String(collection.slides.length).padStart(2,'0')}`;
  };
  const move = (offset: number) => {
    const length = socialCollections[seriesIndex].slides.length;
    slideIndex = (slideIndex + offset + length) % length;
    update();
  };
  gallery.querySelectorAll<HTMLButtonElement>('[data-social-open]').forEach(button => {
    button.addEventListener('click', () => {
      const [id, position] = (button.dataset.socialOpen || '').split(':');
      const found = socialCollections.findIndex(collection => collection.id === id);
      if (found < 0 || !modal) return;
      seriesIndex = found;
      slideIndex = Number(position) || 0;
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      update();
      modal.showModal();
    });
  });
  gallery.querySelector('[data-social-dialog-prev]')?.addEventListener('click', () => move(-1));
  gallery.querySelector('[data-social-dialog-next]')?.addEventListener('click', () => move(1));
  gallery.querySelector('[data-social-close]')?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', event => { if (event.target === modal) modal.close(); });
  modal?.addEventListener('close', () => previousFocus?.focus());
  modal?.addEventListener('keydown', event => {
    if (event.key === 'ArrowRight') {event.preventDefault(); move(1);}
    if (event.key === 'ArrowLeft') {event.preventDefault(); move(-1);}
  });
  gallery.querySelectorAll<HTMLButtonElement>('[data-rail-prev],[data-rail-next]').forEach(button => {
    button.addEventListener('click', () => {
      const id = button.dataset.railPrev || button.dataset.railNext;
      const rail = gallery.querySelector<HTMLElement>(`[data-social-rail="${id}"]`);
      const distance = (rail?.querySelector('.social-slide')?.getBoundingClientRect().width || 300) + 20;
      rail?.scrollBy({ left: button.hasAttribute('data-rail-prev') ? -distance : distance, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
});
</script>
<style>
.social-gallery{display:grid;gap:90px}
.social-collection{min-width:0}
.social-collection-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}
.social-collection-heading{max-width:670px}
.social-collection-heading h3{font-size:clamp(25px,3.2vw,43px);letter-spacing:-.052em;line-height:1.15;margin:12px 0}
.social-collection-heading p{font-size:16px;line-height:1.7;color:var(--muted);max-width:580px;margin:0}
.social-collection-controls{display:flex;align-items:center;gap:9px;flex-shrink:0}
.social-count{font-weight:800;color:#88847f;letter-spacing:.12em;font-size:10px;margin-right:16px}
.social-control{background:transparent;border:1px solid #d6d2cd;width:45px;height:45px;font-size:20px;color:var(--ink);transition:background .2s,color .2s,border-color .2s}
.social-control:hover,.social-control:focus-visible{background:var(--ink);border-color:var(--ink);color:#fff}
.social-rail{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:2px;padding:3px 2px 18px;scrollbar-width:thin;scrollbar-color:#c9c3bd transparent;overscroll-behavior-inline:contain}
.social-slide{width:clamp(220px,27vw,328px);flex:none;scroll-snap-align:start;min-width:0}
.social-slide-open{display:block;width:100%;border:0;padding:0;position:relative;overflow:hidden;background:#e8dfd4;aspect-ratio:4/5;text-align:left}
.social-slide-open img{display:block;width:100%;height:100%;object-fit:contain;transition:filter .3s ease}
.social-slide-open:hover img{filter:brightness(.98)}
.social-slide-view{position:absolute;bottom:0;right:0;padding:11px 14px;background:#1b1918;color:#fff;font-size:11px;font-weight:800;letter-spacing:.03em;opacity:0;transition:opacity .2s}
.social-slide-open:hover .social-slide-view,.social-slide-open:focus-visible .social-slide-view{opacity:1}
.social-slide-meta{display:flex;justify-content:space-between;gap:12px;padding-top:13px;color:#69635e;font-size:12px;line-height:1.35}
.social-slide-meta span:first-child{color:var(--red);font-weight:800;white-space:nowrap;letter-spacing:.045em}
.social-slide-meta span:last-child{text-align:right}
.social-lightbox{width:min(94vw,1100px);height:min(94dvh,990px);max-width:none;max-height:none;border:0;padding:0;background:#181716;color:#fff;box-shadow:0 40px 110px #0007}
.social-lightbox::backdrop{background:rgba(13,13,13,.88)}
.social-lightbox-inner{display:flex;flex-direction:column;height:100%;padding:16px 25px}
.social-lightbox-top,.social-lightbox-foot{display:flex;align-items:center;justify-content:space-between;gap:16px}
.social-lightbox-top{border-bottom:1px solid #373432;padding-bottom:12px}
.social-lightbox-caption{display:grid;gap:3px;min-width:0}
.social-lightbox-caption span{font-size:11px;color:#c9c1ba;text-transform:uppercase;letter-spacing:.1em}
.social-lightbox-caption strong{font-size:15px;font-weight:700;overflow-wrap:anywhere}
.social-lightbox-close{padding:12px 0 12px 18px;background:none;border:none;color:white;white-space:nowrap;font-size:13px}
.social-lightbox-main{display:flex;align-items:center;justify-content:center;gap:20px;min-height:0;flex:1;padding:15px 0}
.social-lightbox-main img{height:100%;max-height:100%;width:auto;max-width:calc(100% - 116px);object-fit:contain}
.social-lightbox-arrow{width:47px;height:47px;flex:none;border:1px solid #5a5653;background:transparent;color:#fff;font-size:22px;transition:background .2s}
.social-lightbox-arrow:hover{background:var(--red);border-color:var(--red)}
.social-lightbox-foot{border-top:1px solid #373432;padding-top:10px;color:#b4aca5;font-size:11px;letter-spacing:.035em}
@media(max-width:720px){.social-gallery{gap:60px}.social-collection-head{align-items:start;flex-direction:column;gap:18px}.social-collection-controls{width:100%;justify-content:flex-end}.social-count{margin-right:auto}.social-slide{width:min(76vw,315px)}.social-rail{gap:14px}.social-slide-view{opacity:1;font-size:10px}.social-lightbox{width:100vw;height:100dvh}.social-lightbox-inner{padding:12px}.social-lightbox-main{gap:7px;padding:8px 0}.social-lightbox-main img{max-width:calc(100% - 74px)}.social-lightbox-arrow{width:31px;height:42px;font-size:19px}.social-lightbox-top{gap:8px}.social-lightbox-caption strong{font-size:13px}}
@media(prefers-reduced-motion:reduce){.social-slide-open img,.social-control,.social-lightbox-arrow{transition:none}}
</style>
